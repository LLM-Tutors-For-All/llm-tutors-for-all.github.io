---
// "What we measure" and "How we measure".
import Section from '../../components/Section.astro';
import { getSection } from '../../lib/content';

const { data } = await getSection('benchmarksPage', 'page');
const { criteria, methods } = data;
---

<Section id="what-we-measure" title={criteria.title}>
  <ul class="criteria" data-reveal>
    {
      criteria.items.map((item) => (
        <li>
          <h3 class="criterion-title">{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))
    }
  </ul>
</Section>

<Section id="how-we-measure" title={methods.title}>
  <dl class="methods" data-reveal>
    {
      methods.items.map((item) => (
        <div class="method">
          <dt>{item.title}</dt>
          <dd>{item.body}</dd>
        </div>
      ))
    }
  </dl>
</Section>

<style>
  .criteria {
    display: grid;
    gap: 2.25rem;
  }

  .criteria li {
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .criterion-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .criteria p {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .methods {
    border-top: 1px solid var(--ink);
  }

  .method {
    display: grid;
    gap: 0.4rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--rule-strong);
  }

  .method dt {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.375rem;
    line-height: 1.2;
    letter-spacing: -0.025em;
  }

  .method dd {
    color: var(--muted);
    font-size: 1rem;
    max-width: 38rem;
  }

  @media (min-width: 48rem) {
    .criteria {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
    }

    .method {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: 2.5rem;
      align-items: baseline;
    }
  }

  @media (min-width: 64rem) {
    .criteria {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
</style>
