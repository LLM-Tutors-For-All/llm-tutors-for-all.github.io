---
import { getSection } from '../lib/content';

const { data, Content } = await getSection('problem', 'problem');
---

<section id="problem" aria-labelledby="problem-title" class="section">
  <div class="container-site">
    <div data-reveal>
      <h2 id="problem-title" class="type-display statement">{data.title}</h2>
      <div class="statement-sub type-lead prose-intro">
        <Content />
      </div>
    </div>

    <dl class="factors" data-reveal>
      {
        data.factors.map((factor) => (
          <div class="factor">
            <dt class="type-h3">{factor.title}</dt>
            <dd>{factor.body}</dd>
          </div>
        ))
      }
    </dl>

    {data.closing && <p class="closing" data-reveal>{data.closing}</p>}
  </div>
</section>

<style>
  .statement {
    max-width: 16ch;
    font-size: clamp(2.375rem, 6vw, 4.5rem);
    font-weight: 750;
    line-height: 1;
    letter-spacing: -0.042em;
  }

  .statement-sub {
    margin-top: 1.75rem;
    max-width: 38rem;
    color: var(--muted);
  }

  .factors {
    display: grid;
    gap: 2rem;
    margin-top: clamp(3.5rem, 8vw, 5.5rem);
  }

  .factor {
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .factor dd {
    margin-top: 0.6rem;
    color: var(--muted);
    font-size: 1rem;
    max-width: 34ch;
  }

  .closing {
    margin-top: clamp(3rem, 7vw, 4.5rem);
    max-width: 44rem;
    font-size: clamp(1.375rem, 2.4vw, 1.75rem);
    line-height: 1.4;
  }

  @media (min-width: 48rem) {
    .factors {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: 2.5rem;
      row-gap: 2.5rem;
    }
  }

  @media (min-width: 64rem) {
    .factors {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      column-gap: 2rem;
    }
  }
</style>
