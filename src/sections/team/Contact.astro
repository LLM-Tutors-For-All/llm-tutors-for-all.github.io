---
import Icon from '../../components/Icon.astro';
import Section from '../../components/Section.astro';
import { getSection, getSite } from '../../lib/content';

const site = await getSite();
const { data } = await getSection('teamPage', 'page');
---

<Section id="get-involved" title={data.contactTitle}>
  <ul class="ways" data-reveal>
    {
      site.email && (
        <li class="way">
          <h3 class="type-h3">{data.emailTitle}</h3>
          <p class="way-body">{data.emailBody}</p>
          <a class="email" href={`mailto:${site.email}`}>
            <Icon name="mail" size={22} />
            <span>{site.email}</span>
          </a>
        </li>
      )
    }
    {
      data.ways.map((way) => (
        <li class="way">
          <h3 class="type-h3">{way.title}</h3>
          <p class="way-body">{way.body}</p>
          <a class="link way-link" href={way.link.href}>
            {way.link.label}
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .ways {
    display: grid;
    gap: 2.25rem;
  }

  .way {
    display: flex;
    flex-direction: column;
    padding-top: 1.25rem;
    border-top: 1px solid var(--ink);
  }

  .way-body {
    margin-top: 0.5rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .way-link {
    margin-top: 1rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: 0.015em;
  }

  .email {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1rem;
    font-family: var(--font-display);
    font-weight: 650;
    font-size: clamp(1.25rem, 2.2vw, 1.5rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    overflow-wrap: anywhere;
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  .email :global(svg) {
    flex: none;
    color: var(--muted);
  }

  @media (min-width: 48rem) {
    .ways {
      grid-template-columns: 1.4fr 1fr 1fr;
      column-gap: 2.5rem;
    }
  }
</style>
