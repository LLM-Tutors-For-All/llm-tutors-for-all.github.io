---
// The top of an inner page: its <h1> and introduction.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="page-intro">
  <div class="container-site">
    <h1 class="type-display page-title">{title}</h1>
    <div class="page-lead type-lead prose-intro">
      <slot />
    </div>
  </div>
</header>

<style>
  .page-intro {
    padding-block: clamp(3.5rem, 9vw, 6.5rem) clamp(3.5rem, 8vw, 5.5rem);
  }

  .page-title {
    font-size: clamp(3rem, 8vw, 5.75rem);
    line-height: 0.98;
    letter-spacing: -0.025em;
  }

  .page-lead {
    margin-top: 1.75rem;
    max-width: 42rem;
  }
</style>
