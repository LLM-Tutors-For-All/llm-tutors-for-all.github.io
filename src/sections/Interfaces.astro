---
import Section from '../components/Section.astro';
import { getSection } from '../lib/content';

const { data, Content } = await getSection('interfaces', 'interfaces');
---

<Section id="interfaces" title={data.title}>
  <Content slot="intro" />

  <ul class="iface-grid" data-reveal>
    {
      data.items.map((item) => (
        <li class="iface">
          <h3 class="iface-name">{item.name}</h3>
          <p class="iface-summary">{item.summary}</p>
          <p class="iface-label">{item.examplesLabel}</p>
          <ul class="iface-examples">
            {item.examples.map((example) => (
              <li>
                <code>{example}</code>
              </li>
            ))}
          </ul>
          {item.note && <p class="iface-note">{item.note}</p>}
          <a class="iface-link" href={item.link.href}>
            {item.link.label}
          </a>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .iface-grid {
    display: grid;
    gap: 1.25rem;
  }

  .iface {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem 1.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 4px;
    transition: border-color 200ms ease;
  }

  /* The top edge is a logo bar: short at rest, full width and amber on hover. */
  .iface::before {
    content: '';
    position: absolute;
    top: -1px;
    left: 1.5rem;
    right: 1.5rem;
    height: 3px;
    border-radius: 0 0 3px 3px;
    background: var(--ink);
    transform: scaleX(0.14);
    transform-origin: left;
    transition:
      transform 360ms cubic-bezier(0.2, 0.7, 0.2, 1),
      background-color 200ms ease;
  }

  .iface:hover,
  .iface:focus-within {
    border-color: var(--ink);
  }

  .iface:hover::before,
  .iface:focus-within::before {
    transform: scaleX(1);
    background: var(--signal);
  }

  .iface-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.1;
    letter-spacing: -0.03em;
  }

  .iface-summary {
    margin-top: 0.75rem;
    color: var(--muted);
    font-size: 1rem;
  }

  .iface-label {
    margin-top: 1.5rem;
    color: var(--muted);
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.0625rem;
    letter-spacing: 0.015em;
  }

  .iface-examples {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .iface-examples code {
    display: block;
    padding: 0.5rem 0.7rem;
    border-radius: 3px;
    background: var(--surface);
    font-size: 0.8125rem;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .iface-note {
    margin-top: 1rem;
    color: var(--muted);
    font-size: 0.875rem;
  }

  .iface-link {
    margin-top: auto;
    padding-top: 1.5rem;
    font-family: var(--font-ui);
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: 0.015em;
    text-decoration: underline;
    text-decoration-color: var(--signal);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.22em;
  }

  /* The whole card is the link's hit area. */
  .iface-link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 4px;
  }

  .iface-link:focus-visible {
    outline: none;
  }

  .iface-link:focus-visible::after {
    outline: 2px solid var(--focus);
    outline-offset: 3px;
  }

  @media (min-width: 48rem) {
    .iface-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .iface::before {
      transition: none;
    }
  }
</style>
